<view class="container">
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索婴儿车、书籍、家电……" value="{{keyword}}" bindinput="onKeyword" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">✕</text>
  </view>
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="category-row">
      <view wx:for="{{categories}}" wx:key="id" class="category-pill {{selectedCategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view>
    </view>
  </scroll-view>
  <view class="result-bar"><text class="result-count">{{visibleListings.length}} 个物品</text></view>
  <view class="grid" wx:if="{{visibleListings.length}}">
    <view class="item-card" wx:for="{{visibleListings}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="cover-wrap">
        <image wx:if="{{item.images && item.images.length}}" class="cover-image" src="{{item.images[0]}}" mode="aspectFill"/>
        <view wx:else class="cover-placeholder">{{item.category === 'free' ? '🎁' : '📦'}}</view>
        <text class="badge" wx:if="{{item.price === 0}}">免费</text>
        <text class="badge reserved" wx:elif="{{item.status === 'reserved'}}">已预定</text>
      </view>
      <view class="card-body">
        <view class="item-title">{{item.title}}</view>
        <view class="item-bottom">
          <text class="price">{{item.price === 0 ? '免费' : '¥' + item.price}}</text>
          <text class="seller">{{item.sellerName}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="empty" wx:else>没有找到相关物品</view>
</view>
