.search { display:flex; gap:16rpx; align-items:center; }
.search input { flex:1; }
.category-scroll { margin:22rpx 0; white-space:nowrap; }
.category-row { display:inline-flex; gap:14rpx; }
.category-pill { padding:14rpx 24rpx; border-radius:999rpx; background:#fff; color:#59616a; }
.category-pill.active { background:#16a085; color:#fff; }
.result-count { color:#8a929b; margin-bottom:16rpx; }
.grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; }
.item-card { padding:16rpx; min-width:0; }
.cover { height:250rpx; background:#eef2f2; border-radius:14rpx; display:flex; align-items:center; justify-content:center; font-size:72rpx; position:relative; }
.cover-image { width:100%; height:100%; border-radius:14rpx; }
.status { position:absolute; top:12rpx; right:12rpx; background:rgba(0,0,0,.65); color:#fff; border-radius:999rpx; padding:6rpx 12rpx; font-size:20rpx; }
.item-title { font-size:30rpx; font-weight:700; margin-top:16rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.item-desc { color:#8a929b; font-size:24rpx; margin:10rpx 0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.item-bottom { display:flex; justify-content:space-between; align-items:end; }
.seller { max-width:140rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:22rpx; }
