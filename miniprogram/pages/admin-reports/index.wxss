.summary { display:grid; grid-template-columns:repeat(3,1fr); gap:14rpx; }
.summary-item { text-align:center; padding:22rpx 10rpx; }
.number { font-size:42rpx; font-weight:800; margin-bottom:6rpx; }
.warning { color:#d46b08; }
.reviewing { color:#1677ff; }
.success { color:#087f6b; }
.tabs { margin:24rpx 0; white-space:nowrap; }
.tab-row { display:inline-flex; gap:12rpx; }
.tab { padding:14rpx 22rpx; border-radius:999rpx; background:#fff; color:#59616a; }
.tab.active { background:#16a085; color:#fff; }
.report { margin-bottom:18rpx; }
.report-head { display:flex; justify-content:space-between; gap:18rpx; align-items:flex-start; }
.title { flex:1; font-size:32rpx; font-weight:700; }
.status { flex-shrink:0; padding:6rpx 14rpx; border-radius:999rpx; font-size:22rpx; }
.status-pending { background:#fff7e6; color:#d46b08; }
.status-reviewing { background:#e6f4ff; color:#1677ff; }
.status-resolved { background:#eaf7f4; color:#087f6b; }
.status-dismissed { background:#f1f2f3; color:#687078; }
.reason { margin-top:18rpx; color:#3c444b; }
.note,.result { margin-top:12rpx; line-height:1.6; color:#59616a; }
.result { padding:16rpx; background:#f6f7f8; border-radius:12rpx; }
.meta { margin-top:12rpx; font-size:24rpx; }
.actions { display:flex; justify-content:flex-end; margin-top:20rpx; padding-top:18rpx; border-top:1rpx solid #eef0f2; }
.actions button { margin:0; }