<view class="container">
  <view class="hero">
    <view class="hero-title">三湘邻里闲置</view>
    <view class="hero-subtitle">让闲置继续发挥价值</view>
    <button class="hero-btn" bindtap="goMarketplace">去逛逛</button>
  </view>

  <view class="notice" bindtap="goRules">
    <text class="notice-icon">📢</text>
    <text class="notice-text">{{notice}}</text>
    <text class="notice-arrow">›</text>
  </view>

  <view class="section-label">物品分类</view>
  <view class="category-grid">
    <view class="category-item" wx:for="{{categories}}" wx:key="id" data-category="{{item.id}}" bindtap="goMarketplace">
      <view class="category-icon">{{item.icon}}</view>
      <view class="category-name">{{item.name}}</view>
    </view>
  </view>

  <view class="section-row">
    <view class="section-label">最新发布</view>
    <view class="section-more" bindtap="goMarketplace">查看全部 ›</view>
  </view>
  <view wx:if="{{latest.length}}">
    <view class="listing" wx:for="{{latest}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="list-cover"><image wx:if="{{item.images && item.images.length}}" src="{{item.images[0]}}" mode="aspectFill"/><text wx:else>{{item.category === 'free' ? '🎁' : '📦'}}</text></view>
      <view class="list-body">
        <view class="list-title">{{item.title}}</view>
        <view class="list-desc">{{item.description}}</view>
        <view class="list-bottom">
          <text class="price">{{item.price === 0 ? '免费' : '¥' + item.price}}</text>
          <text class="list-seller">{{item.sellerName}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="empty-card" wx:else>
    <view class="empty-icon">🏘️</view>
    <view>暂无在售物品</view>
  </view>
</view>
