.profile { display:flex; align-items:center; gap:22rpx; position:relative; padding:30rpx 28rpx; padding-right:132rpx; background:linear-gradient(135deg,#fff 0%,#f0fbf8 100%); border:1rpx solid rgba(22,160,133,.08); }
.avatar-wrap { width:104rpx; height:104rpx; flex:none; }
.avatar, .avatar-image { width:104rpx; height:104rpx; border-radius:50%; }
.avatar { display:flex; align-items:center; justify-content:center; background:#dff5ef; color:#087f6b; font-size:46rpx; box-shadow:0 6rpx 16rpx rgba(22,160,133,.14); }
.avatar-image { display:block; box-shadow:0 6rpx 16rpx rgba(22,160,133,.14); }
.profile-info { min-width:0; flex:1; }
.name { color:#1f2d35; font-size:36rpx; font-weight:700; line-height:1.35; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.profile .muted { font-size:24rpx; line-height:1.5; }
.profile-hint { margin-top:8rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.profile-edit { position:absolute; top:50%; right:24rpx; transform:translateY(-50%); width:auto; min-width:72rpx; height:52rpx; margin:0; padding:0 12rpx; border:0; border-radius:999rpx; background:transparent; color:#087f6b; font-size:24rpx; line-height:52rpx; }
.profile-edit::after { border:0; }
.profile-edit-hover { background:#eaf7f4; }
.profile-prompt { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-top:18rpx; padding:22rpx 24rpx; background:#f0fbf8; border:1rpx solid rgba(22,160,133,.1); }
.prompt-copy { min-width:0; flex:1; }
.prompt-title { color:#1f2d35; font-size:28rpx; font-weight:600; margin-bottom:6rpx; }
.prompt-copy .muted { font-size:23rpx; line-height:1.45; }
.prompt-action { flex:none; width:112rpx; height:56rpx; margin:0; padding:0; border:0; border-radius:999rpx; background:#16a085; color:#fff; font-size:24rpx; line-height:56rpx; }
.prompt-action::after { border:0; }
.prompt-action-hover { background:#0f8f76; }
.modal-mask { position:fixed; z-index:1000; inset:0; display:flex; align-items:center; justify-content:center; padding:40rpx; box-sizing:border-box; background:rgba(15,28,32,.48); animation:mask-fade .18s ease-out; }
.modal-panel { width:100%; max-width:640rpx; box-sizing:border-box; padding:40rpx 36rpx 32rpx; border-radius:28rpx; background:#fff; box-shadow:0 24rpx 80rpx rgba(12,39,35,.2); animation:panel-in .22s ease-out; }
.modal-icon { width:88rpx; height:88rpx; margin:0 auto 22rpx; border-radius:50%; text-align:center; line-height:88rpx; font-size:40rpx; background:#eaf7f4; }
.modal-title { color:#1f2d35; font-size:34rpx; line-height:1.4; font-weight:700; text-align:center; }
.modal-title.align-left { text-align:left; }
.modal-desc { margin-top:18rpx; color:#657279; font-size:26rpx; line-height:1.7; text-align:center; }
.privacy-points { margin-top:28rpx; padding:22rpx 24rpx; border-radius:16rpx; background:#f6faf9; }
.privacy-point { display:flex; align-items:flex-start; gap:14rpx; color:#45535a; font-size:25rpx; line-height:1.6; }
.privacy-point + .privacy-point { margin-top:12rpx; }
.point-dot { width:10rpx; height:10rpx; flex:none; margin-top:15rpx; border-radius:50%; background:#16a085; }
.privacy-read { margin-top:24rpx; color:#8a969b; font-size:22rpx; line-height:1.6; text-align:center; }
.privacy-link { color:#087f6b; }
.modal-actions { display:flex; gap:20rpx; margin-top:30rpx; }
.modal-button { flex:1; height:80rpx; margin:0; padding:0 20rpx; border:0; border-radius:999rpx; font-size:28rpx; font-weight:600; line-height:80rpx; }
.modal-button::after { border:0; }
.modal-button.primary { color:#fff; background:#16a085; }
.modal-button.secondary { color:#4f5e64; background:#f0f3f4; }
.modal-button[disabled] { opacity:.55; }
.modal-header { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; }
.modal-subtitle { margin-top:6rpx; color:#8a969b; font-size:23rpx; line-height:1.5; }
.modal-close { width:56rpx; height:56rpx; flex:none; margin-top:-10rpx; color:#8a969b; font-size:48rpx; font-weight:300; line-height:52rpx; text-align:center; }
.avatar-field { display:flex; flex-direction:column; align-items:center; margin-top:34rpx; }
.avatar-picker-wrap { position:relative; width:144rpx; height:144rpx; border-radius:24rpx; background:#eef9f6; overflow:hidden; }
.avatar-picker { position:absolute; z-index:2; inset:0; width:100%; height:100%; margin:0; padding:0; border:0; border-radius:24rpx; line-height:normal; background:transparent; opacity:0; }
.avatar-picker::after { border:0; }
.editor-avatar { position:absolute; inset:6rpx; display:block; width:132rpx; height:132rpx; box-sizing:border-box; border:0; border-radius:18rpx; background:#eef9f6; box-shadow:none; }
.field-title { margin-top:18rpx; color:#26343a; font-size:27rpx; font-weight:600; }
.field-tip, .input-tip { margin-top:8rpx; color:#98a2a7; font-size:22rpx; line-height:1.5; }
.nickname-field { margin-top:30rpx; }
.field-label { margin-bottom:12rpx; color:#26343a; font-size:26rpx; font-weight:600; }
.name-input { width:100%; height:84rpx; padding:0 24rpx; box-sizing:border-box; border:1rpx solid #dfe7e7; border-radius:16rpx; color:#1f2d35; font-size:28rpx; background:#f8faf9; }
.profile-actions { margin-top:34rpx; }
@keyframes mask-fade { from { opacity:0; } to { opacity:1; } }
@keyframes panel-in { from { opacity:0; transform:translateY(18rpx) scale(.97); } to { opacity:1; transform:translateY(0) scale(1); } }
.section-title { margin-top:36rpx; margin-bottom:16rpx; font-size:30rpx; }
.menu { padding:0 28rpx; overflow:hidden; }
.menu-item { min-height:96rpx; display:flex; align-items:center; justify-content:space-between; border-bottom:1rpx solid #eef1f2; color:#303940; font-size:28rpx; }
.menu-item:last-child { border-bottom:0; }
.menu-item > text:last-child { color:#a3adb3; font-size:38rpx; font-weight:300; }
