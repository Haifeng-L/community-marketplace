.profile { display:flex; align-items:center; gap:24rpx; padding:36rpx 28rpx; }
.avatar { width:100rpx; height:100rpx; border-radius:50%; background:#eaf7f4; display:flex; align-items:center; justify-content:center; font-size:48rpx; }
.name { font-size:36rpx; font-weight:800; margin-bottom:10rpx; }
.menu { padding:0 24rpx; }
.menu-item { display:flex; justify-content:space-between; padding:30rpx 4rpx; border-bottom:1rpx solid #eef0f2; }
.menu-item:last-child { border-bottom:0; }
