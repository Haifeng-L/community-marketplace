<view class="container">
  <view class="admin-tip card">已接入 CloudBase 后，所有管理动作都会按 users.role 做权限校验，并保留操作日志。</view>
  <view class="workbench card" bindtap="goReports">
    <view><view class="workbench-title">🛡 举报处理</view><view class="muted">查看居民举报并进行核实、下架或驳回</view></view>
    <view class="badge" wx:if="{{pendingReports}}">{{pendingReports}}</view><text>›</text>
  </view>
  <view class="section-title">发布审核</view>
  <view class="result-count">待审核 {{pending.length}} 条</view>
  <view class="card review-item" wx:for="{{pending}}" wx:key="id">
    <view data-id="{{item.id}}" bindtap="goDetail"><view class="title">{{item.title}}</view><view class="desc">{{item.description}}</view><view class="muted">发布者：{{item.sellerName}} · {{item.createdAt}}</view></view>
    <view class="actions"><button class="secondary-button" size="mini" data-id="{{item.id}}" bindtap="approve">通过</button><button class="danger-button" size="mini" data-id="{{item.id}}" bindtap="reject">驳回</button></view>
  </view>
  <view class="empty card" wx:if="{{!pending.length}}">暂无待审核内容</view>
</view>